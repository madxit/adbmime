# ---------------------------------------------------------------
# AdbMime web console configuration
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------

# HTTP server. HOST must be reachable by the boards (do NOT use
# 127.0.0.1) otherwise on-screen popups and audio cannot be loaded.
PORT=8080
HOST=0.0.0.0

# Login credentials. When BOTH are empty, the login form accepts
# empty username and password (default, handy for first setup).
AUTH_USERNAME=
AUTH_PASSWORD=

# Secret used to sign the session cookie. If empty a random one is
# generated at every start (users must log in again after restart).
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Path to the adb executable (leave "adb" if it is in the PATH).
ADB_PATH=adb
# TCP port the boards expose ADB on.
ADB_PORT=5555

# Comma separated list of CIDR subnets to scan, e.g.
# SCAN_SUBNETS=192.168.1.0/24,192.168.2.0/24
# Empty = auto-detect the /24 networks of this PC's interfaces.
SCAN_SUBNETS=
SCAN_TIMEOUT_MS=700
SCAN_CONCURRENCY=128
AUTO_SCAN_ON_START=true

# Base URL the boards use to reach this server (for popups/audio).
# Empty = auto-detected from the network interface facing each board.
PUBLIC_BASE_URL=

# Folders whose content can be cleared from the UI must live under
# one of these roots (comma separated).
CLEAR_ALLOWED_ROOTS=/sdcard,/storage/emulated/0,/storage,/mnt/sdcard,/data/local/tmp

# Text-to-speech voice used to generate audio announcements.
# macOS: a `say` voice (e.g. Alice), Linux: an espeak voice (e.g. it).
# Empty = first Italian voice found.
TTS_VOICE=
